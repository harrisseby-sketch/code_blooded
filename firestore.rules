rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // QueueSync data: queues/{locationId}/members (current requests),
    // queues/{locationId}/history (served archive), queues/{locationId}/feedback.
    //
    // ROLE MODEL (canteen vs photostat admin)
    // --------------------------------------
    // The app currently signs staff in with a client-side admin code
    // (AuthService, ADMIN@2026) - there is NO Firebase Auth session yet, so
    // the rules below cannot tell "student" from "admin" or a canteen admin
    // from a photostat admin. "Only the canteen admin may serve canteen" is
    // enforced in the UI: the /admin route is admin-gated and the Serve
    // actions only touch their own location (AdminController / AdminService).
    //
    // Once Firebase Auth is added, enforce server-side with custom claims:
    //   - Admin claims  : request.auth.token.canteenStaff / photostatStaff
    //   - Member delete : allow delete: if canServe(locationId);
    // and remove the `|| true` fallbacks below. The helper functions are
    // already in place - just switch the member-delete rule.

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Per-location staff claims (set on the Firebase Auth token).
    function isCanteenStaff() {
      return signedIn() && request.auth.token.canteenStaff == true;
    }

    function isPhotostatStaff() {
      return signedIn() && request.auth.token.photostatStaff == true;
    }

    // May this caller act on (serve from) `locationId`?
    function canServe(locationId) {
      return signedIn() && (
        (locationId == 'canteen' && isCanteenStaff()) ||
        (locationId == 'photostat' && isPhotostatStaff()) ||
        isAdmin()
      );
    }

    match /queues/{locationId} {
      // Queue stats doc: { count, updatedAt }
      allow read: if true;
      // Open writes keep joins/serves working without Auth. Tighten later:
      //   allow write: if isAdmin();
      allow write: if request.auth == null || request.auth != null; // open w/ merge; tighten with admin claim later
    }

    match /queues/{locationId}/members/{studentId} {
      allow read: if true;
      // Join: any caller may create their own member doc.
      allow create: if request.resource.data.keys().hasAll(['joinedAt']);
      // Leave early / update payload: allowed while present (UI gates it).
      allow update: if true;
      // Serve (delete) is a staff action for THIS location. The app has no
      // Firebase Auth yet, so it stays open at the member level and the UI
      // (admin-gated /admin route + AdminController) enforces the role.
      // Replace with the line below when Auth is introduced:
      //   allow delete: if canServe(locationId);
      allow delete: if true;
    }

    match /queues/{locationId}/history/{studentId} {
      // Served archive written atomically by the serve transaction.
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    match /queues/{locationId}/feedback/{studentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}